        "# Import libraries\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# ==============================\n",
        "# UPLOAD CSV FILE\n",
        "# ==============================\n",
        "\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Get the uploaded file name automatically\n",
        "file_name = next(iter(uploaded))\n",
        "\n",
        "# Read CSV file\n",
        "df = pd.read_csv(\n",
        "    file_name,\n",
        "    engine=\"python\",\n",
        "    on_bad_lines=\"skip\"\n",
        ")\n",
        "\n",
        "# Display column names\n",
        "print(\"Columns in dataset:\")\n",
        "print(df.columns)\n",
        "\n",
        "# Convert relevant columns to numeric, coercing errors and dropping NaNs\n",
        "df['Calories'] = pd.to_numeric(df['Calories'], errors='coerce')\n",
        "df.dropna(subset=['Calories'], inplace=True)\n",
        "\n",
        "df['Protein\\n(g)'] = pd.to_numeric(df['Protein\\n(g)'], errors='coerce')\n",
        "df.dropna(subset=['Protein\\n(g)'], inplace=True)\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 1. TOP 10 FOOD COMPANIES - BAR CHART\n",
        "# ==============================\n",
        "\n",
        "top = df[\"Company\"].value_counts().head(10)\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(top.index, top.values)\n",
        "\n",
        "plt.xticks(rotation=45, ha=\"right\")\n",
        "plt.xlabel(\"Company\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.title(\"Top 10 Food Companies\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 2. TOP 10 FOOD COMPANIES - PIE CHART\n",
        "# ==============================\n",
        "\n",
        "category = df[\"Company\"].value_counts().head(10)\n",
        "\n",
        "plt.figure(figsize=(8, 8))\n",
        "\n",
        "plt.pie(\n",
        "    category.values,\n",
        "    labels=category.index,\n",
        "    autopct=\"%1.1f%%\",\n",
        "    startangle=90,\n",
        "    pctdistance=0.8,\n",
        "    textprops={\"fontsize\": 10}\n",
        ")\n",
        "\n",
        "plt.title(\"Top 10 Food Companies\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 3. CALORIE DISTRIBUTION - HISTOGRAM\n",
        "# ==============================\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.hist(\n",
        "    df[\"Calories\"],\n",
        "    bins=15,\n",
        "    edgecolor=\"black\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Calories (kcal)\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.title(\"Distribution of Calories\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 4. CALORIES VS PROTEIN - SCATTER PLOT\n",
        "# ==============================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    df[\"Calories\"],\n",
        "    df[\"Protein\\n(g)\"],\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Calories (kcal)\")\n",
        "plt.ylabel(\"Protein (g)\")\n",
        "plt.title(\"Calories vs Protein\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 5. CALORIES - BOX PLOT\n",
        "# ==============================\n",
        "\n",
        "plt.figure(figsize=(5, 7))\n",
        "\n",
        "plt.boxplot(df[\"Calories\"])\n",
        "\n",
        "plt.title(\"Calories Box Plot\")\n",
        "plt.ylabel(\"Calories (kcal)\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# 6. TOP 20 FOOD ITEMS BY CALORIES\n",
        "# ==============================\n",
        "\n",
        "top = df.nlargest(20, \"Calories\")\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "plt.bar(\n",
        "    top[\"Item\"],\n",
        "    top[\"Calories\"]\n",
        ")\n",
        "\n",
        "plt.xticks(rotation=60, ha=\"right\")\n",
        "\n",
        "plt.xlabel(\"Food Item\")\n",
        "plt.ylabel(\"Calories (kcal)\")\n",
        "plt.title(\"Top 20 Food Items by Calories\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
